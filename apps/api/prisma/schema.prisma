generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TESTER
  DEVELOPER
  ADMIN
  TRIAGE
}

model User {
  id        Int      @id @default(autoincrement())
  username  String?  @unique
  email     String   @unique
  password  String
  role      Role     @default(TESTER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  isEmailVerified      Boolean  @default(false)
  verificationToken    String?


  failedLoginAttempts  Int      @default(0)
  lockUntil            DateTime?

  passwordResetToken   String?
  passwordResetExpiry  DateTime?


  refreshTokens        RefreshToken[]
  passwordHistory      PasswordHistory[]

 

  testCases TestCase[]
  templates TestCaseTemplate[]
  createdTestRuns TestRun[]
  assignedTestRunItems TestRunItem[]
  
  assignedBugs  Bug[] @relation("AssignedBugs")
  createdBugs   Bug[] @relation("CreatedBugs")
  bugComments   BugComment[] @relation("BugComments")
  deletedBugs   Bug[] @relation("DeletedBugs")
  bugDeletionAudits BugDeletionAudit[] @relation("BugDeletionAudits")

  notifications Notification[]
  createdProjects Project[] @relation("ProjectCreatedBy")
  createdWebhookEndpoints WebhookEndpoint[] @relation("WebhookCreatedBy")

}
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}
model PasswordHistory {
  id        String   @id @default(uuid())
  password  String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Severity {
  BLOCKER
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum TestType {
  FUNCTIONAL
  REGRESSION
  SMOKE
  INTEGRATION
  UAT
  PERFORMANCE
  SECURITY
  USABILITY
}

enum TestStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  DEPRECATED
  ARCHIVED
}

enum AutomationStatus {
  NOT_AUTOMATED
  IN_PROGRESS
  AUTOMATED
  CANNOT_AUTOMATE
}


model TestCase {
  id          String   @id @default(uuid())
  testCaseId  String?  
  title       String   
  
  description String

  module      String
  priority    Priority
  severity    Severity
  type        TestType
  status      TestStatus

  preConditions String
  testData      String
  environment   String

  estimatedDuration Int? 
  automationStatus  AutomationStatus?
  automationLink    String?

  version     Int      @default(1)
  isDeleted   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])

  steps       TestStep[]

  @@index([status, priority])
  history     TestCaseHistory[]
  testSuites  TestSuiteTestCase[]
  testRunItems TestRunItem[]


}

model TestStep {
  id             String  @id @default(uuid())
  stepNumber     Int
  action         String
  testData       String?
  expectedResult String
  actualResult   String?
  status         String?

  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id])

  createdAt DateTime @default(now())
}

model TestCaseHistory {
  id             String     @id @default(uuid())
  testCaseId     String
  version        Int
  title          String
  description    String?
  module         String?
  priority       Priority
  severity       Severity
  type           TestType
  status         TestStatus
  preConditions  String?
  testData       String?
  expectedResult String?
  postConditions String?    // <--- Added this as requested
  environment    String?
  changedAt      DateTime   @default(now())
  changedBy      Int?
  stepsSnapshot  Json?
  testCase       TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
}
model TestCaseTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   // Login, CRUD, API, etc.
  title       String
  priority    Priority
  severity    Severity
  type        TestType

  preConditions String?
  testData      String?
  environment   String?
  stepsSnapshot Json

  createdAt   DateTime @default(now())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])

  isActive Boolean @default(true)
}

model TestSuite {
  id            String   @id @default(uuid())
  name          String
  description   String?
  module        String?
  projectId     String?
  parentSuiteId String?
  parentSuite   TestSuite?  @relation("SuiteHierarchy", fields: [parentSuiteId], references: [id])
  childSuites   TestSuite[] @relation("SuiteHierarchy")
  testCases     TestSuiteTestCase[]
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  isArchived    Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TestSuiteTestCase {
  id          String   @id @default(uuid())
  testSuiteId String
  testCaseId  String
  order       Int

  testSuite   TestSuite @relation(fields: [testSuiteId], references: [id])
  testCase    TestCase  @relation(fields: [testCaseId], references: [id])

  @@unique([testSuiteId, testCaseId])
}
enum TestRunStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ExecutionStatus {
  NOT_STARTED
  IN_PROGRESS
  PASSED
  FAILED
  BLOCKED
}

enum StepExecutionStatus {
  PASS
  FAIL
  BLOCKED
  SKIPPED
}

enum EvidenceType {
  IMAGE
  VIDEO
  LOG
  HAR
}
enum MilestoneStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ProjectEntityType {
  TEST_CASE
  TEST_SUITE
  TEST_RUN
  BUG
}

enum CustomFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
}

model Project {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  config      Json?
  isArchived  Boolean  @default(false)
  createdById Int?
  createdBy   User?    @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  customFields ProjectCustomField[]
  milestones   Milestone[]
  testCases    TestCase[]
  testSuites   TestSuite[]
  testRuns     TestRun[]
  templates    TestCaseTemplate[]
  bugs         Bug[]
  webhookEndpoints WebhookEndpoint[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectCustomField {
  id           String            @id @default(uuid())
  projectId    String
  entityType   ProjectEntityType
  name         String
  fieldType    CustomFieldType
  required     Boolean           @default(false)
  options      Json?
  defaultValue String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, entityType, name])
  @@index([projectId, entityType])
}

model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  name        String
  description String?
  status      MilestoneStatus @default(PLANNED)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testRuns TestRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId, status])
}
model TestRun {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      TestRunStatus @default(PLANNED)

  startDate   DateTime?
  endDate     DateTime?
  projectId   String?
  milestoneId String?

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  testRunItems TestRunItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model TestRunItem {
  id String @id @default(uuid())

  testRunId  String
  testCaseId String

  assignedToId Int?
  assignedTo   User? @relation(fields: [assignedToId], references: [id])

  status ExecutionStatus @default(NOT_STARTED)

  startedAt   DateTime?
  
  completedAt DateTime?

  totalTimeSeconds Int @default(0)
  pausedAt        DateTime?
  accumulatedTime Int @default(0)
  reExecutionOfId String?
  reExecutionOf   TestRunItem? @relation("ReExecution", fields: [reExecutionOfId], references: [id])
  reExecutions    TestRunItem[] @relation("ReExecution")

  testRun  TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id])

  stepExecutions TestExecutionStep[]

  @@index([testRunId, testCaseId])
}
model TestExecutionStep {
  id String @id @default(uuid())

  testRunItemId String

  stepNumber Int
  action String
  expectedResult String

  actualResult String?
  status StepExecutionStatus?

  executedAt DateTime?

  testRunItem TestRunItem @relation(fields: [testRunItemId], references: [id], onDelete: Cascade)

  evidences ExecutionEvidence[]
}
model ExecutionEvidence {
  id String @id @default(uuid())

  testExecutionStepId String

  fileUrl  String
  fileName String
  fileType EvidenceType
  fileSize Int

  uploadedAt DateTime @default(now())

  testExecutionStep TestExecutionStep @relation(fields: [testExecutionStepId], references: [id], onDelete: Cascade)

  @@index([testExecutionStepId])
}
enum BugSeverity {
  BLOCKER
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum BugPriority {
  P1
  P2
  P3
  P4
}

enum BugStatus {
  NEW
  TRIAGE_PENDING
  TRIAGED
  OPEN
  IN_PROGRESS
  FIXED
  VERIFIED
  CLOSED
  REOPENED
  WONT_FIX_REQUESTED
  WONT_FIX
  DUPLICATE
  REJECTED
  SOFT_DELETED
}
model Bug {
  id                String       @id @default(uuid())
  bugId             String       @unique
  projectId         String?
  title             String
  description       String
  stepsToReproduce  String
  expectedBehavior  String
  actualBehavior    String
  severity          BugSeverity
  priority          BugPriority
  status            BugStatus    @default(NEW)
  environment       String?
  affectedVersion   String?
  workStartedAt     DateTime?
  fixedAt           DateTime?
  retestRequestedAt DateTime?
  fixNotes          String?
  fixCommitRef      String?
  resolutionSummary String?
  wontFixReason     String?
  assignedToId      Int?
  createdById       Int
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedById       Int?
  deletedAt         DateTime?
  deletionReason    String?

  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo  User? @relation("AssignedBugs", fields: [assignedToId], references: [id])
  createdBy   User  @relation("CreatedBugs", fields: [createdById], references: [id])
  comments    BugComment[]
  deletedBy   User? @relation("DeletedBugs", fields: [deletedById], references: [id])
  deletionAudits BugDeletionAudit[]
}

enum BugDeletionAction {
  SOFT_DELETE
  RESTORE
}

model BugDeletionAudit {
  id             String            @id @default(uuid())
  bugId          String
  action         BugDeletionAction
  performedById  Int
  performedAt    DateTime          @default(now())
  reason         String?
  previousStatus BugStatus?
  newStatus      BugStatus?

  bug            Bug               @relation(fields: [bugId], references: [id], onDelete: Cascade)
  performedBy    User              @relation("BugDeletionAudits", fields: [performedById], references: [id])

  @@index([bugId, performedAt])
}

model BugComment {
  id              String       @id @default(uuid())
  bugId           String
  parentCommentId String?
  content         String
  contentFormat   String       @default("MARKDOWN")
  createdById     Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  editedAt        DateTime?
  deletedAt       DateTime?

  bug           Bug         @relation(fields: [bugId], references: [id], onDelete: Cascade)
  createdBy     User        @relation("BugComments", fields: [createdById], references: [id])
  parentComment BugComment? @relation("BugCommentThread", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies       BugComment[] @relation("BugCommentThread")

  @@index([bugId, createdAt])
  @@index([parentCommentId])
}

enum NotificationType {
  BUG_ASSIGNED
  BUG_CRITICAL_ASSIGNED
  BUG_REOPENED
  BUG_RETEST_REQUESTED
  BUG_MENTIONED
  BUG_STATUS_CHANGED
  BUG_TRIAGE_REQUIRED
  BUG_WONT_FIX_REVIEW
  BUG_COMMENTED
}

enum WebhookEventType {
  BUG_CREATED
  BUG_UPDATED
  BUG_RESOLVED
  BUG_DELETED
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD
}

model Notification {
  id          String   @id @default(uuid())
  userId      Int
  type        NotificationType
  referenceId String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model WebhookEndpoint {
  id             String             @id @default(uuid())
  name           String
  url            String
  isActive       Boolean            @default(true)
  secret         String?
  projectId      String?
  createdById    Int?
  eventTypes     WebhookEventType[]
  priorityFilter BugPriority[]
  maxRetries     Int                @default(5)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  project   Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("WebhookCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]

  @@index([projectId, isActive])
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  endpointId     String
  bugId          String?
  eventType      WebhookEventType
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  maxAttempts    Int
  requestBody    Json
  responseStatus Int?
  lastError      String?
  nextAttemptAt  DateTime              @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

