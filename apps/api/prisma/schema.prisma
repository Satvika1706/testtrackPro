generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TESTER
  DEVELOPER
  
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(TESTER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testCases TestCase[]
  templates TestCaseTemplate[]
  createdTestRuns TestRun[]
  assignedTestRunItems TestRunItem[]

}


enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Severity {
  BLOCKER
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum TestType {
  FUNCTIONAL
  REGRESSION
  SMOKE
  INTEGRATION
  UAT
  PERFORMANCE
  SECURITY
  USABILITY
}

enum TestStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  DEPRECATED
  ARCHIVED
}

enum AutomationStatus {
  NOT_AUTOMATED
  IN_PROGRESS
  AUTOMATED
  CANNOT_AUTOMATE
}


model TestCase {
  id          String   @id @default(uuid())
  
  // 👇 RELAXED: Removed '@unique'. Now it's just an optional string.
  testCaseId  String?  
  
  // 👇 RELAXED: Removed '@db.VarChar(200)'. Now it accepts any length.
  title       String   
  
  description String

  module      String
  priority    Priority
  severity    Severity
  type        TestType
  status      TestStatus

  preConditions String
  testData      String
  environment   String

  estimatedDuration Int? 
  automationStatus  AutomationStatus?
  automationLink    String?

  version     Int      @default(1)
  isDeleted   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])

  steps       TestStep[]

  @@index([status, priority])
  history     TestCaseHistory[]
  testSuites  TestSuiteTestCase[]
  testRunItems TestRunItem[]


}

model TestStep {
  id             String  @id @default(uuid())
  stepNumber     Int
  action         String
  testData       String?
  expectedResult String
  actualResult   String?
  status         String?

  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id])

  createdAt DateTime @default(now())
}
// ADD THIS AT THE BOTTOM OF schema.prisma

model TestCaseHistory {
  id             String     @id @default(uuid())
  testCaseId     String
  version        Int
  
  // Basic Info
  title          String
  description    String?
  module         String?
  
  // Classification
  priority       Priority
  severity       Severity
  type           TestType
  status         TestStatus
  
  // Execution Details (These were missing!)
  preConditions  String?
  testData       String?
  expectedResult String?
  postConditions String?    // <--- Added this as requested
  environment    String?
  
  // Metadata
  changedAt      DateTime   @default(now())
  changedBy      Int?
  
  // JSON Snapshot of steps
  stepsSnapshot  Json?

  // Relation
  testCase       TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
}
model TestCaseTemplate {
  id          String   @id @default(uuid())

  // Template identity
  name        String
  description String?
  category    String   // Login, CRUD, API, etc.

  // Snapshot fields
  title       String
  priority    Priority
  severity    Severity
  type        TestType

  preConditions String?
  testData      String?
  environment   String?

  // Steps stored as JSON snapshot
  stepsSnapshot Json

  createdAt   DateTime @default(now())
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])

  isActive Boolean @default(true)
}

model TestSuite {
  id            String   @id @default(uuid())
  name          String
  description   String?
  module        String?
  
  // Hierarchy (Parent / Child Suites)
  parentSuiteId String?
  parentSuite   TestSuite?  @relation("SuiteHierarchy", fields: [parentSuiteId], references: [id])
  childSuites   TestSuite[] @relation("SuiteHierarchy")

  // Relations
  testCases     TestSuiteTestCase[]

  // Management
  isArchived    Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TestSuiteTestCase {
  id          String   @id @default(uuid())
  testSuiteId String
  testCaseId  String

  // Order of execution inside suite
  order       Int

  testSuite   TestSuite @relation(fields: [testSuiteId], references: [id])
  testCase    TestCase  @relation(fields: [testCaseId], references: [id])

  @@unique([testSuiteId, testCaseId])
}
enum TestRunStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ExecutionStatus {
  NOT_STARTED
  IN_PROGRESS
  PASSED
  FAILED
  BLOCKED
}

enum StepExecutionStatus {
  PASS
  FAIL
  BLOCKED
  SKIPPED
}

enum EvidenceType {
  IMAGE
  VIDEO
  LOG
  HAR
}
model TestRun {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      TestRunStatus @default(PLANNED)

  startDate   DateTime?
  endDate     DateTime?

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id])

  testRunItems TestRunItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model TestRunItem {
  id String @id @default(uuid())

  testRunId  String
  testCaseId String

  assignedToId Int?
  assignedTo   User? @relation(fields: [assignedToId], references: [id])

  status ExecutionStatus @default(NOT_STARTED)

  startedAt   DateTime?
  
  completedAt DateTime?

  totalTimeSeconds Int @default(0)
  pausedAt        DateTime?
  accumulatedTime Int @default(0)


  // Re-execution support
  reExecutionOfId String?
  reExecutionOf   TestRunItem? @relation("ReExecution", fields: [reExecutionOfId], references: [id])
  reExecutions    TestRunItem[] @relation("ReExecution")

  testRun  TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase TestCase @relation(fields: [testCaseId], references: [id])

  stepExecutions TestExecutionStep[]

  @@index([testRunId, testCaseId])
}
model TestExecutionStep {
  id String @id @default(uuid())

  testRunItemId String

  stepNumber Int
  action String
  expectedResult String

  actualResult String?
  status StepExecutionStatus?

  executedAt DateTime?

  testRunItem TestRunItem @relation(fields: [testRunItemId], references: [id], onDelete: Cascade)

  evidences ExecutionEvidence[]
}
model ExecutionEvidence {
  id String @id @default(uuid())

  testExecutionStepId String

  fileUrl  String
  fileName String
  fileType EvidenceType
  fileSize Int

  uploadedAt DateTime @default(now())

  testExecutionStep TestExecutionStep @relation(fields: [testExecutionStepId], references: [id], onDelete: Cascade)

  @@index([testExecutionStepId])
}

