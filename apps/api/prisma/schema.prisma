generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TESTER
  DEVELOPER
  
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  role      Role
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  testCases TestCase[]
  templates TestCaseTemplate[]

}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Severity {
  BLOCKER
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum TestType {
  FUNCTIONAL
  REGRESSION
  SMOKE
  INTEGRATION
  UAT
  PERFORMANCE
  SECURITY
  USABILITY
}

enum TestStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  DEPRECATED
  ARCHIVED
}

enum AutomationStatus {
  NOT_AUTOMATED
  IN_PROGRESS
  AUTOMATED
  CANNOT_AUTOMATE
}


model TestCase {
  id          String   @id @default(uuid())
  
  // 👇 RELAXED: Removed '@unique'. Now it's just an optional string.
  testCaseId  String?  
  
  // 👇 RELAXED: Removed '@db.VarChar(200)'. Now it accepts any length.
  title       String   
  
  description String

  module      String
  priority    Priority
  severity    Severity
  type        TestType
  status      TestStatus

  preConditions String
  testData      String
  environment   String

  estimatedDuration Int? 
  automationStatus  AutomationStatus?
  automationLink    String?

  version     Int      @default(1)
  isDeleted   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])

  steps       TestStep[]

  @@index([status, priority])
  history     TestCaseHistory[]
}

model TestStep {
  id             String  @id @default(uuid())
  stepNumber     Int
  action         String
  testData       String?
  expectedResult String
  actualResult   String?
  status         String?

  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id])

  createdAt DateTime @default(now())
}
// ADD THIS AT THE BOTTOM OF schema.prisma

model TestCaseHistory {
  id             String     @id @default(uuid())
  testCaseId     String
  version        Int
  
  // Basic Info
  title          String
  description    String?
  module         String?
  
  // Classification
  priority       Priority
  severity       Severity
  type           TestType
  status         TestStatus
  
  // Execution Details (These were missing!)
  preConditions  String?
  testData       String?
  expectedResult String?
  postConditions String?    // <--- Added this as requested
  environment    String?
  
  // Metadata
  changedAt      DateTime   @default(now())
  changedBy      Int?
  
  // JSON Snapshot of steps
  stepsSnapshot  Json?

  // Relation
  testCase       TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
}
model TestCaseTemplate {
  id          String   @id @default(uuid())

  // Template identity
  name        String
  description String?
  category    String   // Login, CRUD, API, etc.

  // Snapshot fields
  title       String
  priority    Priority
  severity    Severity
  type        TestType

  preConditions String?
  testData      String?
  environment   String?

  // Steps stored as JSON snapshot
  stepsSnapshot Json

  createdAt   DateTime @default(now())
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id])

  isActive Boolean @default(true)
}
